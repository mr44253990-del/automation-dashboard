# Never commit real credentials. Copy to .env and chmod 600.
AUTOMATION_ENABLED=false
TARGET_URL=https://vyceai.com/dashboard-v2
LOGIN_URL=https://vyceai.com/login
TARGET_EMAIL=
TARGET_PASSWORD=
SCHEDULE_TIME=20:17
SCHEDULE_TIMEZONE=Asia/Dhaka
HEADLESS=true
SCREENSHOT_DIR=screenshots
LOG_DIR=logs
SCREENSHOT_RETENTION_HOURS=12

# Notifications
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FCM_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=

# AI providers (optional; values stay server-side)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
